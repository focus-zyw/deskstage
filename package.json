{
  "name": "virtual-character",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prototype:settings": "vite --open /settings-prototype.html",
    "prototype:chatlog": "vite --open /chatlog-prototype.html",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "test": "node --test tests/*.test.mjs",
    "test:bubble": "node --test tests/bubbleEngine.test.mjs tests/bubbleThemes.test.mjs",
    "test:fast": "node --test tests/bubbleEngine.test.mjs tests/bubbleThemes.test.mjs tests/configMigration.test.mjs tests/configPartial.test.mjs tests/dialogProtocol.test.mjs tests/scriptValidation.test.mjs tests/turnBatch.test.mjs tests/toolSystem.test.mjs tests/runtimeMode.test.mjs tests/hotkeys.test.mjs tests/mention.test.mjs tests/sentenceSplitter.test.mjs",
    "test:shard": "node --test",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-http": "^2.6.0",
    "pako": "^3.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "oxlint": "^1.79.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
